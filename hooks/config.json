{
  "protected_files": ["backlog.json"],
  "backlog_cli": "python backlog.py",
  "protected_branches": ["master", "main"],
  "work_branch": "dev",

  "line_limits": {
    "count": "non_blank",
    "warn_ratio": 0.85,
    "rules": [
      { "name": "백엔드 테스트",      "glob": "backend/tests/**/*.py",   "max_file": 400, "max_function": 60 },
      { "name": "백엔드 API 라우터",  "glob": "backend/app/api/**/*.py", "max_file": 200, "max_function": 40 },
      { "name": "백엔드 모듈",        "glob": "backend/**/*.py",         "max_file": 300, "max_function": 50 },
      { "name": "프론트 컴포넌트",    "glob": "frontend/src/**/*.tsx",   "max_file": 250, "max_function": 80 },
      { "name": "프론트 로직",        "glob": "frontend/src/**/*.ts",    "max_file": 200, "max_function": 50 },
      { "name": "스크립트",           "glob": "scripts/**/*.py",         "max_file": 200, "max_function": 50 },
      { "name": "훅 스크립트",        "glob": "hooks/*.py",              "max_file": 260, "max_function": 60 },
      { "name": "백로그 CLI",         "glob": "backlog.py",              "max_file": 450, "max_function": 60 }
    ]
  },

  "lint_on_edit": [
    { "glob": ["backend/**/*.py"],                                "cwd": "backend",  "cmd": "ruff check {file}" },
    { "glob": ["frontend/src/**/*.ts", "frontend/src/**/*.tsx"],  "cwd": "frontend", "cmd": "npx --no-install eslint {file}" }
  ],

  "quality_gate": [
    { "name": "backend lint",   "requires": "backend",               "cwd": "backend",  "cmd": "ruff check ." },
    { "name": "backend build",  "requires": "backend",               "cwd": "backend",  "cmd": "python -m compileall -q ." },
    { "name": "frontend lint",  "requires": "frontend/package.json", "cwd": "frontend", "cmd": "npm run lint --silent" },
    { "name": "frontend build", "requires": "frontend/package.json", "cwd": "frontend", "cmd": "npm run build --silent" }
  ],
  "gate_max_blocks": 3,

  "task_guard": {
    "enabled": true,
    "exempt": ["docs/tasks/**", "rules/**", ".claude/**", ".codex/**", ".vscode/**", "hooks/**", "CLAUDE.md", "AGENTS.md", "README.md", ".gitignore", "problem.md", "backlog.py"]
  },

  "review": {
    "required_for_done": true,
    "dir": "docs/tasks",
    "exempt_epics": ["E0"],
    "verdicts": ["PASS", "NEEDS_FIX", "HUMAN_REVIEW"]
  },

  "popup": {
    "style": "notification",
    "on_stop": true,
    "on_permission": true
  }
}
