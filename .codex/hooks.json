{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python hooks/session_start.py", "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python hooks/user_prompt.py", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python hooks/guard_backlog.py", "timeout": 10 },
          { "type": "command", "command": "python hooks/task_guard.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python hooks/backlog_sync.py", "timeout": 900 },
          { "type": "command", "command": "python hooks/code_guard.py", "timeout": 150 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python hooks/stop.py", "timeout": 900 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python hooks/session_end.py", "timeout": 3 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python hooks/notify.py", "timeout": 10 }
        ]
      }
    ]
  }
}
